# RouteMem AI Gateway Environment Template
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info

# Database Connections
REDIS_URL=redis://localhost:6379/0
QDRANT_URL=http://localhost:6333
ZEP_API_URL=http://localhost:8000

# Embedding & Profiling Models
EMBEDDING_MODEL_PATH=BAAI/bge-small-en-v1.5

# Inference Vendor API Keys
GROQ_API_KEY=gsk_your_groq_api_key_here
GEMINI_API_KEY=AQ_your_gemini_api_key_here
DEEPSEEK_API_KEY=sk_your_deepseek_api_key_here
OPENAI_API_KEY=sk_your_openai_api_key_here
ANTHROPIC_API_KEY=sk_your_anthropic_api_key_here

# Gateway Parameters & Thresholds
EXACT_CACHE_ENABLED=true
EXACT_CACHE_TTL_SECONDS=86400
SEMANTIC_CACHE_ENABLED=true
SEMANTIC_CACHE_THRESHOLD=0.95
COMPRESSION_ENABLED=true
COMPRESSION_RATIO=0.80
MONTHLY_BUDGET_LIMIT_USD=500.0
